<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Carried so TrollStore grants them at install time. Only what it takes
	     to put the diagnostic log in the media folder, where the file browser
	     can open it: the app is otherwise confined to its own container and
	     the log lands behind an identifier nobody can guess.

	     Deliberately NOT here: com.apple.private.security.no-container. The
	     app keeps its own container, so settings, favourites and the saved
	     session stay where they are; granting that one would move the
	     container and lose all of them. -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/private/var/mobile/Media/</string>
	</array>
</dict>
</plist>
